{
	admin off
	persist_config off
	auto_https off
}

:{$PORT:80} {
	root * /usr/share/caddy
	# Jeden host kanoniczny. Railway przekazuje oryginalny Host do Caddy,
	# więc wariant www nie powinien pozostawać osobną kopią 200.
	@www host www.fish-point.pl
	redir @www https://fish-point.pl{uri} 301


	# Nagłówki bezpieczeństwa są celowo kompatybilne z osadzonymi komentarzami
	# Giscus. CSP działa najpierw w trybie raportowania, aby nie blokować
	# istniejących materiałów, gdy lista źródeł będzie dalej zawężana.
	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), geolocation=(self), microphone=(), payment=(), usb=()"
		Strict-Transport-Security "max-age=31536000"
		Content-Security-Policy-Report-Only "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self' https://assets.mailerlite.com; script-src 'self' 'unsafe-inline' https://giscus.app; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' https://giscus.app https://api.github.com; frame-src 'self' https://giscus.app; media-src 'self' https:"
	}

	# Canonical directory URLs: tylko istniejące pliki index.html trafiają do
	# przekierowania, więc błędne ścieżki nadal kończą jako prawdziwe 404.
	@root_index {
		path /index.html
		file {
			try_files {path}
		}
	}
	redir @root_index / 301

	@section_index {
		path_regexp section_index ^/(.+)/index\.html$
		file {
			try_files {path}
		}
	}
	redir @section_index /{re.section_index.1}/ 301

	# Kompresja tylko treści tekstowych (HTML/CSS/JS/XML/SVG/JSON).
	# Obrazy są już skompresowane — pomijamy je, dzięki czemu nie dostają
	# Vary: Accept-Encoding i możemy czysto ustawić Vary: Accept dla negocjacji.
	encode {
		gzip
		zstd
		match {
			header Content-Type text/*
			header Content-Type application/javascript*
			header Content-Type application/json*
			header Content-Type application/xml*
			header Content-Type image/svg+xml*
		}
	}

	# Negocjacja nowoczesnych formatów obrazów — podmiana zachodzi TYLKO gdy
	# przeglądarka deklaruje wsparcie (Accept), a wariant istnieje na dysku.
	# Scrapery (FB/Twitter) i starsze klienty dostają oryginalny JPG/PNG.
	# Kolejność: AVIF (najmniejszy) -> WebP -> oryginał.
	@avif {
		header Accept *image/avif*
		path *.jpg *.jpeg *.png
		file {
			try_files {path}.avif
		}
	}
	rewrite @avif {path}.avif

	@webp {
		header Accept *image/webp*
		path *.jpg *.jpeg *.png
		file {
			try_files {path}.webp
		}
	}
	rewrite @webp {path}.webp

	file_server

	# Ładne 404 zgodne ze stroną
	handle_errors {
		@404 expression {err.status_code} == 404
		rewrite @404 /404.html
		file_server
	}

	# Cache dla zasobów statycznych
	# Dokumenty muszą być odświeżane po publikacji; kanał i manifest mogą
	# pozostać krótko w cache, ale zawsze wolno je ponownie zweryfikować.
	@html path / *.html */
	header @html Cache-Control "public, max-age=0, must-revalidate"
	@feeds path /feed.xml /sitemap.xml
	header @feeds Cache-Control "public, max-age=900, must-revalidate"
	@manifest path /site.webmanifest
	header @manifest Cache-Control "public, max-age=86400, must-revalidate"

	# Niefingerprintowane obrazy i zasoby zachowują miesięczny TTL.
	@assets path /assets/* /css/* /js/*
	header @assets Cache-Control "public, max-age=2592000"
	# Wersjonowane JS i CSS mogą być cache'owane bez ponownego pobrania.
	# Pozostałe, niefingerprintowane obrazy pozostają przy bezpieczniejszym
	# miesięcznym TTL, aby ich podmiana pod tą samą ścieżką nie utkwiła na rok.
	@fingerprinted_assets {
		path /css/* /js/*
		query v=*
	}
	header @fingerprinted_assets Cache-Control "public, max-age=31536000, immutable"
	# Warianty obrazów zależą od nagłówka Accept — cache/CDN ma je rozróżniać.
	# Matcher łapie też ścieżki po przepisaniu na .avif/.webp; +Vary dokłada
	# nagłówek obok istniejącego Vary: Accept-Encoding (z encode).
	@imgvariants path_regexp imgvariants ^/assets/.+\.(?:jpe?g|png|avif|webp)$
	header @imgvariants +Vary Accept
}
